{
  "name": "kida-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "postinstall": "prisma generate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "prisma generate && prisma db push --accept-data-loss && prisma db seed || true && node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.0.12",
    "@nestjs/config": "4.0.0",
    "@nestjs/core": "11.0.12",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.3",
    "@nestjs/platform-express": "11.0.12",
    "@nestjs/platform-socket.io": "11.0.12",
    "@nestjs/serve-static": "5.0.2",
    "@nestjs/swagger": "11.0.6",
    "@nestjs/throttler": "6.4.0",
    "@nestjs/websockets": "11.0.12",
    "@prisma/client": "6.0.0",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "compression": "1.7.5",
    "cookie-parser": "1.4.7",
    "helmet": "8.0.0",
    "multer": "1.4.5-lts.2",
    "passport": "0.7.0",
    "passport-apple": "2.0.2",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "4.0.1",
    "redis": "4.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "sharp": "0.33.5",
    "socket.io": "4.8.1",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.20",
    "@nestjs/schematics": "11.0.4",
    "@nestjs/testing": "11.0.12",
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "5.0.0",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.0",
    "@types/passport-apple": "2.0.3",
    "@types/passport-google-oauth20": "2.0.16",
    "@types/passport-jwt": "4.0.1",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.0.0",
    "@typescript-eslint/parser": "8.0.0",
    "eslint": "9.0.0",
    "jest": "29.7.0",
    "prisma": "6.0.0",
    "ts-jest": "29.2.0",
    "ts-loader": "9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
